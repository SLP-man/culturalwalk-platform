# 复制为 infra/.env 后按需改。不要把真实密钥提交到仓库。
DB_PORT=5432
S3_PORT=9000
S3_CONSOLE_PORT=9001

DATABASE_URL=postgresql+psycopg://cw:cw@localhost:5432/culturalwalk
DB_ECHO=false

# 认证：本地随便填，demo/生产必须换成随机串
JWT_SECRET=dev-only-change-me

# 对象存储
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=culturalwalk
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# 外部 Provider：留 fake 可完全离线演示
MAP_PROVIDER=fake
MAP_API_KEY=
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

ENV=local
DEBUG=true
